{
  "mcpServers": {
    "misarseo": {
      "command": "npx",
      "args": [
        "-y",
        "@misarseo/mcp@latest"
      ],
      "env": {
        "MISARSEO_API_KEY": "mseo_YOUR_KEY_HERE"
      }
    },
    "misarseo-remote": {
      "url": "https://api.misar.io/seo/mcp",
      "headers": {
        "Authorization": "Bearer mseo_YOUR_KEY_HERE"
      }
    }
  }
}
